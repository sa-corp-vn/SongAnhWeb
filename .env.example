# Cơ sở dữ liệu: file SQLite cục bộ (máy chủ riêng / Docker)…
DATABASE_URL=file:./data/sa.db
# …hoặc Turso khi deploy Netlify: DATABASE_URL=libsql://<ten-db>-<tai-khoan>.turso.io + token
DATABASE_AUTH_TOKEN=
# Ảnh tải lên: để trống = lưu thư mục media/; có token = lưu trên UploadThing (bắt buộc với Netlify)
UPLOADTHING_TOKEN=
PAYLOAD_SECRET=thay-bang-chuoi-ngau-nhien-dai
NEXT_PUBLIC_SITE_URL=https://sa-corp.vn
# 1 = chặn máy tìm kiếm (bản chạy thử trên *.netlify.app, tránh trùng nội dung với sa-corp.vn)
SITE_NOINDEX=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_TO=tnc@sa-corp.vn
